MCHID=
APPID=
APP_SECRET=
API_V3_KEY=
SERIAL_NO=
PORT=3000
NOTIFY_URL=
REFUND_NOTIFY_URL=
ADMIN_TOKEN=

# 对外站点地址。Vercel Preview 可留空自动按当前预览域名生成；
# 正式自定义域名建议明确填写，例如 https://v2.example.com
APP_BASE_URL=

# 微信支付平台证书（回调验签）
WECHAT_PLATFORM_CERT_PATH=

# 人格身份证：服务器需安装 PHP GD + FreeType + mbstring。
# 填服务器上的中文字体绝对路径，例如 NotoSansCJK-Regular.ttc。
# Vercel Docker 镜像已内置 Noto CJK 字体，通常无需手动设置。
CARD_FONT_PATH=
# 默认可留空，代码会使用 https://api.qrserver.com/v1/create-qr-code/
QR_API_URL=

# Vercel 会自动设置 VERCEL=1 / VERCEL_ENV=preview|production。
# Preview 且未配置 DB 时，代码自动启用无持久化体验模式，保证 12 题→结果→身份证→分享可测试。
# 本地需要模拟该模式时才手动设为 1；生产环境不要开启。
TYPE_ME_PREVIEW_MODE=0
# Vercel 默认以内联 data URL 返回身份证 PNG，避免依赖临时容器磁盘。
CARD_INLINE_RESPONSE=0

# P0 数据库目标：MySQL 8 / MariaDB 10.5+，PDO MySQL。
# 示例：mysql:host=127.0.0.1;port=3306;dbname=type_me;charset=utf8mb4
DB_DSN=
DB_USER=
DB_PASS=

# 私有 JSON/NDJSON 兼容镜像目录。传统服务器生产建议明确设置到站点 Web 根目录之外。
# Vercel 未填写时会自动使用 /tmp/type-me-v2-data；它只适合 Preview 临时镜像，不是持久化存储。
# 例如：/www/server/type-me-v2-data
PRIVATE_STORAGE_PATH=

# 微信支付订单与 SKU 预留库存的有效期，允许 5-120 分钟，默认 30。
ORDER_RESERVATION_TTL_MINUTES=30
